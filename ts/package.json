{
  "name": "claude-code-sessions",
  "version": "1.1.2",
  "description": "Cross-directory manager for Claude Code sessions: browse/search/archive/resume — native Node (ink) TUI, Python twin included",
  "license": "MIT",
  "author": "biedongbin",
  "homepage": "https://github.com/biedongbin/ccs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biedongbin/ccs.git"
  },
  "keywords": [
    "claude-code",
    "claude",
    "sessions",
    "tui",
    "terminal"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "dist",
    "ccs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/eaw.json','dist/eaw.json')\"",
    "test": "npm run -s build && node test/parity.cjs",
    "test:shell": "node test/spawn.test.cjs",
    "test:unit": "node test/resume.test.cjs && node test/summary.test.cjs && node test/tui.test.cjs",
    "e2e": "npm run -s build && python3 test/pty_e2e.py",
    "prepublishOnly": "npm run -s build && node -e \"const fs=require('fs');fs.copyFileSync('../ccs','ccs');fs.copyFileSync('../README.md','README.md')\""
  },
  "bin": {
    "ccs": "dist/cli.js",
    "ccs-py": "bin/ccs.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^2.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ink": "^4.4.1",
    "react": "^18.3.1"
  },
  "type": "module"
}