{
  "name": "claude-code-sessions",
  "version": "1.0.0",
  "description": "Cross-directory manager for Claude Code sessions: browse/search/archive/resume — Python-core npm distribution",
  "license": "MIT",
  "author": "biedongbin",
  "homepage": "https://github.com/biedongbin/ccs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biedongbin/ccs.git"
  },
  "keywords": [
    "claude-code",
    "claude",
    "sessions",
    "tui",
    "terminal"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "ccs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/eaw.json','dist/eaw.json')\"",
    "test": "npm run -s build && node test/parity.js",
    "test:shell": "node test/spawn.test.js",
    "test:unit": "node test/resume.test.js && node test/summary.test.js"
  },
  "bin": {
    "ccs": "bin/ccs.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3"
  }
}
