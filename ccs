CACHE_VERSION = 15   # +1: last_reply 预算 500→4000   # +1: cwd realpath 归一符号链接   # +1: 标题链对齐官方（custom-title > ai-title > summary > 首问）   # +1: title 净化换行（多行 title 折行泄漏到边框外）   # +1: 隐藏 sdk-cli 衍生会话   # +1: 取消一切归组折叠，cwd=启动目录   # +1: 归组锚定 home 下前两级   # +1: 目录编码规则修正（_/./全压-，还原下划线真实路径）   # +1: worktree 启动折回主仓库   # +1: cwd 改为编码目录名反推的真实启动目录   # +1: 首问流式兜底   # 解析语义变更（黑名单等）时 +1，旧缓存条目整体失效

class Cache:
    def __init__(self, ccs_home: str):
        os.makedirs(ccs_home, exist_ok=True)
        self.path = os.path.join(ccs_home, "cache.json")
        try:
            with open(self.path, encoding="utf-8") as f:
                self.data = json.load(f)
        except Exception:
            self.data = {}

    def get(self, key):
        v = self.data.get(key)
        return v if isinstance(v, dict) else None

    def put(self, s: SessionMeta, mtime_ns: int):
        self.data[f"v{CACHE_VERSION}|{s.path}|{mtime_ns}"] = {k: getattr(s, k) for k in _CACHE_FIELDS}

    def save(self):
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.data, f, ensure_ascii=False)
        os.replace(tmp, self.path)

def scan_projects(projects_dir, archive_dir, cache=None, refresh=False):
    if cache is None:
        cache = Cache(os.path.dirname(archive_dir.rstrip("/")) or ".")
    entries = []           # (path, archived)
    for d in dict.fromkeys((projects_dir, archive_dir)):
        if not os.path.isdir(d):
            continue
        for f in sorted(_glob.glob(os.path.join(d, "*.jsonl"))):
            entries.append((f, d == archive_dir))
    metas, sidecars = [], []
    for path, archived in entries:
        try:
            st = os.stat(path)
        except OSError:
            continue
        mtime, mtime_ns = st.st_mtime, st.st_mtime_ns
        key = f"v{CACHE_VERSION}|{path}|{mtime_ns}"
        hit = None if refresh else cache.get(key)
        if hit:
            m = SessionMeta(mtime=mtime, size=st.st_size,
                            path=path, archived=archived, **hit)
        else:
            m = parse_jsonl(path)
            if isinstance(m, Sidecar):
                sidecars.append(m); continue
            if m is None:
                continue
            m.archived = archived
            cache.put(m, mtime_ns)
        if m.entrypoint == "sdk-cli":
            continue                                  # compact/SDK 衍生会话：非用户打开，默认隐藏
        metas.append(m)
    titles = {sc.leaf: sc.summary for sc in sidecars if sc.leaf}
    for m in metas:
        if m.sid in titles and titles[m.sid] and not m.custom_title and not m.ai_title:
            m.title = re.sub(r"\s+", " ", titles[m.sid][:80]).strip()
    metas.sort(key=lambda m: m.mtime, reverse=True)
    return metas

def _project_dirs(projects_dir):
    if not os.path.isdir(projects_dir):
        return []
    return [os.path.join(projects_dir, d) for d in os.listdir(projects_dir)
            if os.path.isdir(os.path.join(projects_dir, d))]

def _archive_dirs(home):
    base = os.path.join(home, "archive")
    if not os.path.isdir(base):
        return []
    return [os.path.join(base, d) for d in os.listdir(base)
            if os.path.isdir(os.path.join(base, d))]

def scan(refresh=False):
    projects, home = paths()
    cache = Cache(home)
    metas = []
    for d in _project_dirs(projects) + _archive_dirs(home):
        metas.extend(scan_projects(d, d, cache, refresh))
    for m in metas:  # archived 统一按路径前缀判定，覆盖 scan_projects 内的判定
        m.archived = m.path.startswith(os.path.join(home, "archive") + os.sep)
    metas.sort(key=lambda m: m.mtime, reverse=True)
    cache.save()
    return metas

def _enc(p: str) -> str:
    return re.sub(r"[^A-Za-z0-9]+", "-", p)

def launch_dir(encoded: str, hint: str = "") -> str:
    """从 ~/.claude/projects 的编码目录名反推真实启动目录。

    编码规则 = 原路径 "/" → "-"。含连字符的真实名靠两级消歧：
    1) 文件内记录的 cwd（可能被会话中途 cd 污染）的祖先链逐一比对编码；
    2) 文件系统贪心解码：能新建组件就新建，不能就并入上一段当连字符。
    """
    if hint:
        d = os.path.abspath(hint)
        while True:
            if _enc(d) == encoded:
                return d
            p = os.path.dirname(d)
            if p == d:
                break
            d = p
    parts = [p for p in encoded.split("-") if p]
    if not encoded.startswith("-"):
        return ""
    base, cur, parts = os.sep, "", parts
    while parts:                                   # 最长匹配：优先把后续段连成存在的目录
        for k in range(len(parts), 0, -1):
            name = "-".join(parts[:k])
            if os.path.isdir(os.path.join(base, cur, name)):
                cur = os.path.join(cur, name) if cur else name
                parts = parts[k:]
                break
        else:                                      # 剩余段全不存在（已删目录等）→ 全按新组件拼
            cur = os.path.join(cur, "/".join(parts))
            parts = []
    return base + cur

def encoded_dir_name(path: str, projects_dir: str) -> str:
    p = os.path.dirname(path)
    if p.startswith(projects_dir):
        rest = p[len(os.path.abspath(projects_dir)):].lstrip(os.sep)
        return rest.split(os.sep)[0] if rest else os.path.basename(p)
    return os.path.basename(p)

def archive_dest(m: SessionMeta, ccs_home: str) -> str:
    projects, _ = paths()
    return os.path.join(ccs_home, "archive", encoded_dir_name(m.path, projects),
                        os.path.basename(m.path))

def do_archive(m: SessionMeta, ccs_home: str) -> str:
    dest = archive_dest(m, ccs_home)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    _shutil.move(m.path, dest)
    return dest

def do_restore(m: SessionMeta, projects_dir: str) -> str:
    encoded = os.path.basename(os.path.dirname(m.path))   # archive/<encoded>/<file>
    dest = os.path.join(projects_dir, encoded, os.path.basename(m.path))
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    _shutil.move(m.path, dest)
    return dest

def do_trash(m: SessionMeta, ccs_home: str) -> str:
    tdir = os.path.join(ccs_home, "trash")
    os.makedirs(tdir, exist_ok=True)
    dest = os.path.join(tdir, os.path.basename(m.path))
    i = 0
    while os.path.exists(dest):
        i += 1
        dest = os.path.join(tdir, f"{os.path.basename(m.path)}.{i}")
    _shutil.move(m.path, dest)
    return dest

def do_rename(m: SessionMeta, name: str) -> bool:
    """等价官方 /rename：向会话 jsonl 追加 custom-title 行（append-only，末条生效）。
    追加后恢复原 mtime：改名不冒充新活动，列表排序/相对时间不动。"""
    line = json.dumps({"type": "custom-title", "customTitle": name,
                       "sessionId": m.sid}, ensure_ascii=False)
    try:
        st = os.stat(m.path)
        with open(m.path, "a", encoding="utf-8") as f:
            f.write(line + "\n")
        os.utime(m.path, ns=(st.st_atime_ns, st.st_mtime_ns))
    except OSError:
        return False
    # mtime 已恢复原值 → 缓存键未变，旧 title 条目会命中，必须按 path 显式驱逐
    cache = Cache(paths()[1])
    cache.data = {k: v for k, v in cache.data.items()
                  if len(k.split("|", 2)) < 2 or k.split("|", 2)[1] != m.path}
    cache.save()
    return True

def summaries_path() -> str:
    return os.path.join(paths()[1], "summaries.json")

def load_summaries() -> dict:
    try:
        with open(summaries_path(), encoding="utf-8") as f:
            v = json.load(f)
            return v if isinstance(v, dict) else {}
    except Exception:
        return {}

def save_summaries(sums: dict):
    tmp = summaries_path() + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(sums, f, ensure_ascii=False)
    os.replace(tmp, summaries_path())

JOBS = {}   # sid -> {proc, out, title}；随 ccs 退出即弃，孤儿输出由 harvest 兜底

def build_summary_argv(m: SessionMeta) -> list:
    prompt = (f"请读取并分析这个 Claude Code 会话记录文件：{m.path}（sessionId={m.sid}）。"
              "输出（中文 Markdown，简洁分节）："
              "1) 会话/需求的所有核心目标；"
              "2) 整体任务工作计划与进度百分比；"
              "3) 当前代码分支状态；"
              "4) 本会话解决了哪些问题，列出问题清单。")
    return ["claude", "-p", prompt, "--allowedTools", "Read"]

def start_summary(m: SessionMeta) -> bool:
    d = os.path.join(paths()[1], "summarize")
    os.makedirs(d, exist_ok=True)
    outp = os.path.join(d, f"{m.sid}.out")
    try:
        proc = _subprocess.Popen(build_summary_argv(m), stdout=open(outp, "wb"),
                                 stderr=_subprocess.DEVNULL, cwd=m.cwd or None)
    except OSError:
        return False
    JOBS[m.sid] = {"proc": proc, "out": outp, "title": m.title}
    return True

def harvest_summaries(max_age: float = 120):
    """收编孤儿输出：ccs 中途退出后 claude 仍写完 .out；下次启动收编（跳过新近文件防误收）。"""
    d = os.path.join(paths()[1], "summarize")
    try:
        names = os.listdir(d)
    except OSError:
        return
    sums = None
    for fn in names:
        if not fn.endswith(".out"):
            continue
        p = os.path.join(d, fn)
        try:
            if _time.time() - os.stat(p).st_mtime < max_age:
                continue
            out = open(p, encoding="utf-8").read().strip()
        except OSError:
            continue
        if out:
            if sums is None:
                sums = load_summaries()
            sums[fn[:-4]] = {"text": out[:20000], "ts": os.stat(p).st_mtime}
        os.remove(p)
    if sums is not None:
        save_summaries(sums)

DEFAULT_RESUME_CMD = "claude --resume {sid}"

def resume_cmd_full(cmd: str) -> str:
    """用户只填基础命令（如 cc）：不含 {sid} 时系统自动追加 --resume {sid}；
    已含 {sid} 的完整模板原样兼容（老配置不破）。"""
    return cmd if "{sid}" in cmd else cmd.rstrip() + " --resume {sid}"

def build_direct_argv(m: SessionMeta, cmd: str = DEFAULT_RESUME_CMD):
    return _shlex.split(resume_cmd_full(cmd).format(sid=m.sid))

def build_resume_argv(m: SessionMeta, cmd: str = DEFAULT_RESUME_CMD) -> list:
    """resume_cmd 是 shell 命令：一律交用户交互 shell 执行——函数/alias/内嵌环境变量与终端一致。
    which 探测不可靠：macOS 自带 /usr/bin/cc（clang），会遮蔽 zshrc 里的同名函数。"""
    if os.name == "nt":                      # ponytail: Windows 无 shell 函数语义，直 execvp，够用
        return build_direct_argv(m, cmd=cmd)
    sh = os.environ.get("SHELL") or "/bin/sh"
    return [sh, "-ic", resume_cmd_full(cmd).format(sid=m.sid)]

class AppState:
    def __init__(self, sessions, archive_view=False):
        self.sessions = sessions
        self.archive_view = archive_view
        self.query = ""
        self.project = None
        self.cursor = 0

    def visible(self):
        q = self.query.lower()
        out = []
        for m in self.sessions:
            if m.archived != self.archive_view:
                continue
            if self.project and m.cwd != self.project:
                continue
            if q and q not in (m.title + m.cwd + m.sid).lower():
                continue
            out.append(m)
        return out

    def projects(self):
        agg = {}
        for m in self.sessions:
            if m.archived != self.archive_view:
                continue
            cur = agg.get(m.cwd)
            if cur is None or m.mtime > cur:
                agg[m.cwd] = m.mtime
        return sorted(agg.items(), key=lambda kv: kv[1], reverse=True)

    def move(self, dy):
        n = len(self.visible())
        if n:
            self.cursor = max(0, min(self.cursor + dy, n - 1))

    def current(self):
        v = self.visible()
        return v[self.cursor] if 0 <= self.cursor < len(v) else None

def _rebuild(old: "AppState", sessions, archive_view: bool) -> "AppState":
    """a/u/d 后重扫：保留 query/project 过滤；光标停在原行（下一项自动补位）。"""
    st2 = AppState(sessions, archive_view)
    st2.query = old.query
    st2.project = old.project
    st2.cursor = min(old.cursor, max(0, len(st2.visible()) - 1))
    return st2

