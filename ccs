        ("lang", "语言 lang", cfg.get("lang", "zh"), _CONFIG_DESCS["lang"]),
        ("theme", "主题 theme", cfg.get("theme", "default"), _CONFIG_DESCS["theme"]),
        ("resume_cmd", "恢复命令 resume_cmd", cfg.get("resume_cmd", DEFAULT_RESUME_CMD), _CONFIG_DESCS["resume_cmd"]),
        ("custom", "自定义调色板 custom", f"{len(custom)} 项", _CONFIG_DESCS["custom"]),
    ]

def _palette_attrs(cfg):
    """按 theme 初始化 curses 色对，返回 (border, sel, time, msg)。主 TUI 与配置面板共用。"""
    PALETTES = {
        "default": (curses.COLOR_CYAN, curses.COLOR_YELLOW),
        "ocean":   (curses.COLOR_BLUE, curses.COLOR_GREEN),
        "dracula": (curses.COLOR_MAGENTA, curses.COLOR_GREEN),
    }
    PALETTES.update(_user_themes(cfg))
    pal = PALETTES.get(cfg.get("theme", "default"), PALETTES["default"])
    border_attr, sel_attr, time_attr, msg_attr = curses.A_DIM, curses.A_REVERSE, curses.A_DIM, curses.A_BOLD
    if curses.has_colors() and pal:
        try:
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, pal[0], -1)
            curses.init_pair(2, pal[1], -1)
            curses.init_pair(3, curses.COLOR_BLACK, pal[0])
            border_attr = curses.color_pair(1) | curses.A_DIM
            sel_attr = curses.color_pair(3) | curses.A_BOLD
            time_attr = curses.color_pair(1)
            msg_attr = curses.color_pair(2)
        except curses.error:
            pass
    return border_attr, sel_attr, time_attr, msg_attr

def _detail_page(stdscr, cfg, title, desc, items,
                 keys=" j/k 选择 select · Enter 确认 · Esc 返回 back", del_ok=False, cur=None):
    """通用整页选择页（无弹层）：反白标题 + 说明 + 分隔线 + 选项列表。
    items 兼容 (label, attr) / (label, attr, value)；Enter 返回 value（缺省 label）；
    del_ok 时按 d 返回 ("__DEL__", value)；Esc/q 返回 None（回列表页）。"""
    border_attr, sel_attr, lab_attr, msg_attr = _palette_attrs(cfg)
    idx = next((i for i, it in enumerate(items) if len(it) > 2 and it[2] == cur), 0)
    while True:
        stdscr.erase()
        H, W = stdscr.getmaxyx()
        _safe_add(stdscr, 0, 0, " " * (W - 1), curses.A_REVERSE)
        _safe_add(stdscr, 0, 1, " ← " + title, curses.A_REVERSE | curses.A_BOLD)
        dls = _md_lines(desc or "", W - 4)[:max(1, H - 10)]
        for j, ln in enumerate(dls):
            _safe_add(stdscr, 2 + j, 2, ln, curses.A_DIM)
        dy = 2 + len(dls) + 1
        _safe_add(stdscr, dy, 2, "-" * max(4, W - 4), border_attr)
        for j, it in enumerate(items):
            at = it[1] if len(it) > 1 else curses.A_DIM
            yy = dy + 1 + j
            selr = j == idx
            if selr:
                _safe_add(stdscr, yy, 1, " " * (W - 2), sel_attr)
            _safe_add(stdscr, yy, 2, ("▸ " if selr else "  ") + _cut(it[0], W - 6),
                      sel_attr if selr else at)
        _safe_add(stdscr, H - 1, 0, keys[:W - 1], curses.A_DIM)
        stdscr.refresh()
        try:
            k = stdscr.get_wch()
        except curses.error:
            continue
        if isinstance(k, int):
            k = curses.keyname(k).decode()
        if k in ("j", "KEY_DOWN"):
            idx = min(idx + 1, len(items) - 1)
        elif k in ("k", "KEY_UP"):
            idx = max(idx - 1, 0)
        elif k in ("\n", "KEY_ENTER"):
            return items[idx][2] if len(items[idx]) > 2 else items[idx][0]
        elif k == "d" and del_ok:
            return ("__DEL__", items[idx][2] if len(items[idx]) > 2 else items[idx][0])
        elif k in ("\x1b", "ESC", "q", "Q"):
            return None

def _color_options():
    """8 基色选项（值, '██ 色名', 色块属性）——reverse 选中时色块变实底更醒目。"""
    opts = []
    for i, c in enumerate(["black", "red", "green", "yellow",
                           "blue", "magenta", "cyan", "white"]):
        try:
            curses.init_pair(10 + i, getattr(curses, "COLOR_" + c.upper()), -1)
            attr = curses.color_pair(10 + i) | curses.A_BOLD
        except curses.error:
            attr = curses.A_BOLD
        opts.append(("██ " + c, attr, c))   # (label, attr, value) 与 _detail_page 约定一致
    return opts

def _config_input(stdscr, y, x, w, initial=""):
    """行内编辑：预填 initial，退格可改，Enter 确认返回 str，Esc 取消返回 None。"""
    curses.curs_set(1)
    buf = initial
    while True:
        iw = max(8, w - x - 2)
        _safe_add(stdscr, y, x, " " * iw, 0)
        _safe_add(stdscr, y, x, _cut(buf, iw), 0)
        try:
            stdscr.move(y, x + min(_dw(buf), iw - 1))
        except curses.error:
            pass
        stdscr.refresh()
        try:
            k = stdscr.get_wch()
        except curses.error:
            continue
        if isinstance(k, int):
            k = curses.keyname(k).decode()
        if k in ("\n", "KEY_ENTER"):
            curses.curs_set(0)
            return buf
        if k in ("\x1b", "ESC"):
            curses.curs_set(0)
            return None
        if k in ("\x7f", "\b", "KEY_BACKSPACE"):
            buf = buf[:-1]
        elif len(k) == 1 and ord(k) >= 32:
            buf += k

def _config_tui(stdscr, cfg: dict):
    """配置面板（两页式，无弹层）：列表页三列表格 → Enter 整页详情。
    q 保存退出（返回 cfg），Esc 原样退出（返回 None）。"""
    curses.curs_set(0)
    border_attr, sel_attr, lab_attr, msg_attr = _palette_attrs(cfg)
    sel, msg = 0, ""

    def _new_custom_flow():
        """新建自定义主题：输名 → 整页选强调色 → 整页选消息色 → 存并启用。返回提示文案。"""
        H, W = stdscr.getmaxyx()
        _safe_add(stdscr, H - 2, 0, " " * (W - 1), 0)
        _safe_add(stdscr, H - 2, 1, "主题名 name:", msg_attr)
        nm = _config_input(stdscr, H - 2, 15, W)
        if not (nm and nm.strip()):
            return ""
        nm = nm.strip()
        acc = _detail_page(stdscr, cfg, "强调色 accent（边框/时间列/选中行）",
                           "选择强调色——作用于边框/时间列/选中行底色。",
                           _color_options(), " j/k 选择 · Enter 确认 · Esc 取消", cur="cyan")
        if not acc:
            return ""
        mc = _detail_page(stdscr, cfg, "消息色 msg（底部消息行）",
                          "选择消息色——作用于底部消息行。",
                          _color_options(), " j/k 选择 · Enter 确认 · Esc 取消", cur="yellow")
        if not mc:
            return ""
        cu = cfg.get("custom") or {}
        cu[nm] = [acc, mc]
        cfg["custom"] = cu
        cfg["theme"] = nm
        return f"已创建并启用 {nm}"

    while True:
        rows = config_rows(cfg)
        stdscr.erase()
        H, W = stdscr.getmaxyx()
        _safe_add(stdscr, 0, 0, " " * (W - 1), curses.A_REVERSE)
        _safe_add(stdscr, 0, 1, " ccs 配置 / config  —  " + config_path(),
                  curses.A_REVERSE | curses.A_BOLD)
        _safe_add(stdscr, 2, 2, "配置项", curses.A_DIM)
        _safe_add(stdscr, 2, 24, "当前值", curses.A_DIM)
        _safe_add(stdscr, 2, 44, "说明", curses.A_DIM)
        disp = {"lang": cfg.get("lang", "zh"),
                "theme": cfg.get("theme", "default"),
                "resume_cmd": resume_cmd_full(cfg.get("resume_cmd", DEFAULT_RESUME_CMD)),
                "custom": f"{len(_user_themes(cfg))} 项"}
        y = 3
        for i, (key, label, _val, desc) in enumerate(rows):
            if y > H - 5:
                break
            dls = _md_lines(desc, max(10, W - 46))
            bh = max(1, len(dls))
            selr = i == sel
            if selr:
                for yy in range(y, y + bh):
                    _safe_add(stdscr, yy, 1, " " * (W - 2), sel_attr)
            _safe_add(stdscr, y, 2, ("▸ " if selr else "  ") + _pad(_cut(label, 20), 20),
                      sel_attr if selr else (lab_attr | curses.A_BOLD))
            _safe_add(stdscr, y, 24, _pad(_cut(disp[key], 18), 18), sel_attr if selr else 0)
            for j, ln in enumerate(dls[:bh]):
                _safe_add(stdscr, y + j, 44, _pad(ln, max(10, W - 46)), 0)
            y += bh + 1
        if msg:
            _safe_add(stdscr, H - 2, 0, _pad(msg, W - 1)[:W - 1], msg_attr)
        _safe_add(stdscr, H - 1, 0,
                  " j/k 移动 move · Enter 进入详情 detail · q 保存退出 save · Esc 原样退出"[:W - 1],
                  curses.A_DIM)
        stdscr.refresh()
        try:
            k = stdscr.get_wch()
        except curses.error:
            continue
        if isinstance(k, int):
            k = curses.keyname(k).decode()
        if k in ("j", "KEY_DOWN"):
            sel = min(sel + 1, len(rows) - 1)
            continue
        if k in ("k", "KEY_UP"):
            sel = max(sel - 1, 0)
            continue
        if k in ("q", "Q"):
            save_config(cfg)
            return cfg
        if k in ("\x1b", "ESC"):
            return None
        if k in ("\n", "KEY_ENTER"):
            msg = ""
            key = rows[sel][0]
            if key == "lang":
                cur = cfg.get("lang", "zh")
                items = [(f"{n} ({c})" + ("  ✓" if c == cur else ""),
                          msg_attr if c == cur else curses.A_DIM, c)
                         for c, n in LANG_NAMES]
                v = _detail_page(stdscr, cfg, "语言 / language", _CONFIG_DESCS["lang"], items)
                if v:
                    cfg["lang"] = v
                    global _LANG
                    _LANG = v
                    msg = f"语言 → {v}"
            elif key == "theme":
                cur = cfg.get("theme", "default")
                names = THEME_NAMES + [n for n in _user_themes(cfg) if n not in THEME_NAMES]
                items = [(t + ("  ✓" if t == cur else ""),
                          msg_attr if t == cur else curses.A_DIM, t) for t in names]
                items.append(("＋ 新建自定义主题 create custom", curses.A_BOLD, "__new__"))
                v = _detail_page(stdscr, cfg, "主题 / theme", _CONFIG_DESCS["theme"], items)
                if v == "__new__":
                    msg = _new_custom_flow()
                elif v:
                    cfg["theme"] = v
                    msg = f"已启用 {v}"
            elif key == "resume_cmd":
                full = resume_cmd_full(cfg.get("resume_cmd", DEFAULT_RESUME_CMD))
                v = _detail_page(stdscr, cfg, "恢复命令 resume_cmd",
                                 _CONFIG_DESCS["resume_cmd"] + f"\n\n当前值 current: `{full}`",
                                 [("编辑基础命令 edit base command", curses.A_BOLD, "__edit__")],
                                 keys=" Enter 编辑 edit · Esc 返回 back")
                if v == "__edit__":
                    _safe_add(stdscr, H - 2, 0, " " * (W - 1), 0)
                    _safe_add(stdscr, H - 2, 1, "resume_cmd + --resume {sid}:", msg_attr)
                    s = _config_input(stdscr, H - 2, 31, W,
                                      cfg.get("resume_cmd", DEFAULT_RESUME_CMD).replace(" --resume {sid}", ""))
                    if s is None:
                        msg = "已取消 cancelled"
                    elif s.strip():
                        cfg["resume_cmd"] = s.strip()
                        msg = "已更新 updated"
                    else:
                        msg = "留空不改动 unchanged"
            else:
                names = list(_user_themes(cfg))
                cur = cfg.get("theme", "default")
                items = [("＋ 新建 create", curses.A_BOLD, "__new__")]
                for nm0 in names:
                    items.append((nm0 + ("  ✓" if nm0 == cur else ""),
                                  msg_attr if nm0 == cur else curses.color_pair(1), nm0))
                v = _detail_page(stdscr, cfg, "自定义调色板 custom", _CONFIG_DESCS["custom"], items,
                                 keys=" j/k 选择 · Enter 使用 use · d 删除 delete · Esc 返回 back",
                                 del_ok=True)
                if v == "__new__":
                    msg = _new_custom_flow()
                elif isinstance(v, tuple) and v[0] == "__DEL__":
                    nm0 = v[1]
                    (cfg.get("custom") or {}).pop(nm0, None)
                    if cfg.get("theme") == nm0:
                        cfg["theme"] = "default"
                    msg = f"已删除 {nm0}"
                elif v:
                    cfg["theme"] = v
                    msg = f"已启用 {v}"

def run_config(first_run: bool = False) -> None:
    """配置入口：首次启动保持引导式问答；ccs --config 进 curses 面板；无 curses 降级问答。"""
    cfg = {} if first_run else load_config()
    if first_run or curses is None:
        run_config_plain(cfg, first_run)
        return
    if curses.wrapper(_config_tui, cfg) is not None:
        print(f"saved -> {config_path()}")

def main(argv) -> int:
    if "--check" in argv:
        return run_check()
    if "--config" in argv:
        run_config()
        return 0
    import argparse
    p = argparse.ArgumentParser(prog="ccs", description="Claude Code 会话管理器")
    p.add_argument("-a", "--archive", action="store_true", help="进入归档区视图")
    p.add_argument("-r", "--refresh", action="store_true", help="忽略缓存全量重扫")
    p.add_argument("--config", action="store_true", help="配置语言/主题")
    args = p.parse_args(argv)
    cfg = load_config()
    global _LANG
    _LANG = cfg.get("lang", "zh")
    if not os.path.exists(config_path()):
        run_config(first_run=True)   # 首次启动：引导配置主题+语言
        cfg = load_config()
        _LANG = cfg.get("lang", "zh")
    resume_cmd = cfg.get("resume_cmd", DEFAULT_RESUME_CMD)
    st = AppState(scan(refresh=args.refresh), archive_view=args.archive)
    harvest_summaries()
    st.project = os.path.realpath(os.getcwd())   # 无条件锚定当前目录（realpath 归一）：无会话则空列表；Esc 查看全部
    projects_dir, home = paths()

    def curses_main(stdscr):
        nonlocal st
        msg = ""
        off = 0          # 左栏列表滚动偏移
        dscroll = 0      # 右栏详情滚动偏移
        last_sid = None
        picker_open = False   # Tab 项目选择弹层
        picker_idx = 0
        searching = False     # 增量搜索：按键即过滤，Esc 清空退出，Enter 确认
        pager_open = False    # 全屏阅读（方案B）：独占按键，q/Esc 返回列表
        pgoff = 0             # pager 内容滚动偏移
        pwin = None           # pager 独立窗口（尺寸变化时重建；覆盖在 stdscr 之上）
        pwin_wh = (0, 0)      # pwin 当前 (H, W)
        picker_items = []     # [(显示名, cwd|None, 会话数)]

        def _open_picker():
            nonlocal picker_items, picker_idx, picker_open
            agg = {}   # cwd -> [count, latest_mtime]
            for m in st.sessions:
                if m.archived == st.archive_view:
                    c0, t0 = agg.get(m.cwd, (0, 0.0))
                    agg[m.cwd] = (c0 + 1, max(t0, m.mtime))
            rows = sorted(agg.items(), key=lambda kv: kv[1][1], reverse=True)
            total = sum(c for c, _t in agg.values())
            newest = max((t for _c, t in agg.values()), default=0.0)
            picker_items = [(T("picker_all"), None, total, newest)] + [
                (os.path.basename(c) or c, c, n, t) for c, (n, t) in rows]
            cl = [c for _n, c, _i, _t in picker_items]
            picker_idx = cl.index(st.project) if st.project in cl else 0
            picker_open = True
        curses.curs_set(0)
        border_attr, sel_attr, time_attr, msg_attr = _palette_attrs(cfg)
        while True:
            for sid in [s0 for s0, jb in JOBS.items() if jb["proc"].poll() is not None]:
                jb = JOBS.pop(sid)
                try:
                    out = open(jb["out"], encoding="utf-8").read().strip()
                except OSError:
                    out = ""
                if jb["proc"].returncode == 0 and out:
                    sums0 = load_summaries()
                    sums0[sid] = {"text": out[:20000], "ts": _time.time()}
                    save_summaries(sums0)
                    msg = T("sum_done").format(t=jb["title"][:24])
                else:
                    msg = T("sum_fail").format(t=jb["title"][:24])
            stdscr.erase()
            H, W = stdscr.getmaxyx()
            if H < 12 or W < 60:
                _safe_add(stdscr, 0, 0, T("too_small").format(w=W, h=H))
                stdscr.refresh()
                try:
                    k = stdscr.getkey()
                except curses.error:
                    continue
                if k in ("q", "Q"):
                    return
                continue
            help_ls = _hard_wrap(T("help"), W - 1)     # 帮助行按宽自动折行（多行时整体上移让位）
            nh = len(help_ls)
            TOP, BOT = 1, H - 2 - nh                   # 分栏边框上下行
            LW = min(60, max(34, W // 2))              # 左栏固定 60 列（时间7+空1+标题50+边框2），窄终端才收缩
            RW = W - LW                                # 右栏 = 其余全部
            it, ib = TOP + 1, BOT - 1                  # 内容行范围
            list_h = ib - it + 1
            vis_h = list_h - 1                     # 左栏表头占 it 行，实际可绘行数少一行
            rows = st.visible()
            n = len(rows)
            off = _clamp_off(st.cursor, off, n, vis_h)
            # 标题栏
            badges = ((T("badge_arch") if st.archive_view else "")
                      + (T("badge_proj").format(v=os.path.basename(st.project) or st.project) if st.project else "")
                      + (T("badge_q").format(v=st.query) if st.query else ""))
            _safe_add(stdscr, 0, 0, " " * (W - 1), curses.A_REVERSE)
            _safe_add(stdscr, 0, 1, " " + T("title").format(n=n) + (f" {badges}" if badges else ""),
                      curses.A_REVERSE | curses.A_BOLD)
            _safe_add(stdscr, 0, max(1, W - 10), f"{st.cursor + 1 if n else 0}/{n} ", curses.A_REVERSE)
            # 左右栏内容（框后画，框线永远完整）
            # 左栏：表头 + 会话列表
            lw = LW - 2
            _safe_add(stdscr, it, 1, T("hdr_cols"), curses.A_DIM)
            now = _time.time()
            for j, m in enumerate(rows[off:off + vis_h]):
                y = it + 1 + j
                t = rel_time(m.mtime, now)
                if off + j == st.cursor:
                    _safe_add(stdscr, y, 1, " " * lw, sel_attr)
                    _safe_add(stdscr, y, 1, _pad(t, 7) + " " + _cut(m.title, lw - 9), sel_attr)
                else:
                    _safe_add(stdscr, y, 1, _pad(t, 7), time_attr)
                    _safe_add(stdscr, y, 9, _cut(m.title, lw - 8))
            if n > vis_h:                             # 左栏滚动指示
                pos = it + 1 + round(off / max(1, n - vis_h) * (vis_h - 1))
                _safe_add(stdscr, min(pos, ib), LW - 1, "|", sel_attr)
            # 右栏：选中会话详情
            cur = st.current()
            if cur:
                if cur.sid != last_sid:
                    dscroll = 0
                    last_sid = cur.sid
                rw = RW - 2
                dlines = _detail_lines(cur, rw, load_summaries())
                dscroll = max(0, min(dscroll, max(0, len(dlines) - list_h)))
                for j, segs in enumerate(dlines[dscroll:dscroll + list_h]):
                    x = LW + 1
                    for txt, attr in segs:
                        t2 = _cut(txt, LW + 1 + rw - x)
                        if not t2:
                            break
                        _safe_add(stdscr, it + j, x, t2, attr)
                        x += _dw(t2)
                if len(dlines) > list_h:
                    pos = it + round(dscroll / max(1, len(dlines) - list_h) * (list_h - 1))
                    _safe_add(stdscr, min(pos, ib), W - 1, "|", sel_attr)
            # 边框最后画——任何宽度误判的内容都被框线压住，永不破框
            _box(stdscr, TOP, 0, LW, BOT - TOP + 1, border_attr)
            _box(stdscr, TOP, LW, RW, BOT - TOP + 1, border_attr)
            _safe_add(stdscr, TOP, LW + 2, T("detail"), border_attr)
            # 状态行 + 帮助行
            _safe_add(stdscr, H - 1 - nh, 0, ((T("search_p") + st.query + "▌") if searching else msg)[:W - 1], msg_attr)
            for hi, hl in enumerate(help_ls):
                _safe_add(stdscr, H - nh + hi, 0, hl[:W - 1], curses.A_DIM)
            # Tab 项目选择弹层（最上层）
            if picker_open and picker_items:
                pw = min(W - 6, 96)
                ph = min(len(picker_items) + 2, H - 4)
                px = (W - pw) // 2
                py = 1
                _box(stdscr, py, px, pw, ph, sel_attr)
                _safe_add(stdscr, py, px + 2, T("picker_t"), sel_attr)
                vis = ph - 2
                poff = max(0, min(picker_idx - vis + 1, max(0, len(picker_items) - vis)))
                name_w, cnt_w, time_w = 24, 5, 11
                path_w = pw - 2 - name_w - cnt_w - time_w - 2
                for j, (name, pcwd, cnt, mt) in enumerate(picker_items[poff:poff + vis]):
                    yy = py + 1 + j
                    selr = poff + j == picker_idx
                    if selr:
                        _safe_add(stdscr, yy, px + 1, " " * (pw - 2), sel_attr)
                    mark = "*" if pcwd == st.project else " "
                    p = (pcwd or "").replace(os.path.expanduser("~"), "~")
                    if _dw(p) > path_w:
                        p = ".." + p[2 - path_w:] if path_w > 2 else ""
                    parts = [(_pad(_cut(f"{mark} {name}", name_w), name_w), 0),
                             (_pad(_cut(p, path_w), path_w), curses.A_DIM),
                             (f"{cnt:>{cnt_w}} ", 0),
                             (_pad(rel_time(mt, now), time_w), curses.A_DIM)]
                    xx = px + 1
                    for txt, at in parts:
                        _safe_add(stdscr, yy, xx, txt, sel_attr if selr else at)
                        xx += _dw(txt)
            stdscr.refresh()
            # 全屏阅读 pager：独立窗口整帧重推（stdscr 差分会丢弃纯垫白行，newwin+touchwin 规避）
            if pager_open and st.current():
                curp = st.current()
                if pwin_wh != (H, W):
                    pwin = curses.newwin(H, W, 0, 0)
                    pwin_wh = (H, W)
                dls = _detail_lines(curp, W - 2, load_summaries())
                pgoff = max(0, min(pgoff, max(0, len(dls) - (H - 2))))
                pwin.erase()
                _safe_add(pwin, 0, 0, " " * (W - 1), curses.A_REVERSE)
                _safe_add(pwin, 0, 0, _cut(f" {curp.title}  [{pgoff + 1}/{len(dls)}]", W - 1),
                          curses.A_REVERSE | curses.A_BOLD)
                for row, segs in enumerate(dls[pgoff:pgoff + H - 2]):
                    yy = 1 + row
                    _safe_add(pwin, yy, 0, " " * (W - 1), 0)
                    xx = 0
                    for txt, attr in segs:
                        t2 = _cut(txt, W - 1 - xx)
                        if not t2:
                            break
                        _safe_add(pwin, yy, xx, t2, attr)
                        xx += _dw(t2)
                _safe_add(pwin, H - 1, 0, " " * (W - 1), curses.A_REVERSE)   # 底行末格不可写，少垫一格
                _safe_add(pwin, H - 1, 0, _cut(T("pager_hint"), W - 1), curses.A_REVERSE)
                pwin.touchwin()
                pwin.refresh()
            stdscr.timeout(500 if JOBS else -1)   # 无后台任务时阻塞等键：空闲零重绘（消闪烁）；有任务时半秒轮询
            try:
                k = stdscr.get_wch()                 # 宽字符读取：CJK 整字返回，杜绝字节级乱码
            except curses.error:
                continue
            if isinstance(k, int):                   # 功能键 → "KEY_xxx" 名，兼容既有分支
                k = curses.keyname(k).decode()
            if k not in ("KEY_UP", "KEY_DOWN", "j", "k", "g", "G", "J", "K",
                         "KEY_MOUSE", "KEY_PPAGE", "KEY_NPAGE", "s"):
                msg = ""                      # 移动/滚动键保留状态行，其余键先清空再处理
            if picker_open:                   # 弹层模式：独占按键
                if k in ("j", "KEY_DOWN"):
                    picker_idx = min(picker_idx + 1, len(picker_items) - 1)
                elif k in ("k", "KEY_UP"):
                    picker_idx = max(picker_idx - 1, 0)
                elif k in ("\n", "KEY_ENTER"):
                    st.project = picker_items[picker_idx][1]
                    st.cursor = 0
                    off = 0
                    picker_open = False
                elif k in ("\x1b", "ESC", "q", "Q", "\t"):
                    picker_open = False
                continue
            if pager_open:                    # 全屏阅读：独占按键，j/k 滚内容不切会话
                if k in ("j", "KEY_DOWN"):
                    pgoff += 1
                elif k in ("k", "KEY_UP"):
                    pgoff = max(0, pgoff - 1)
                elif k in (" ", "KEY_NPAGE"):
                    pgoff += max(1, H - 2)
                elif k in ("b", "KEY_PPAGE"):
                    pgoff = max(0, pgoff - max(1, H - 2))
                elif k == "g":
                    pgoff = 0
                elif k == "G":
                    pgoff = 10 ** 9
                elif k in ("q", "Q", "\x1b", "ESC"):
                    pager_open = False
                continue
            if searching:                     # 增量搜索：吃掉所有可打印键，q 不再误退出
                if k in ("\x1b", "ESC"):
                    searching = False
                    st.query = ""
                    st.cursor = 0
                    off = 0
                elif k in ("\n", "KEY_ENTER"):
                    searching = False
                elif k in ("\x7f", "\b", "KEY_BACKSPACE"):
                    st.query = st.query[:-1]
                    st.cursor = 0
                    off = 0
                elif len(k) == 1 and ord(k) >= 32:
                    st.query += k
                    st.cursor = 0
                    off = 0
                continue
            if k in ("q", "Q"):
                return
            elif k in ("KEY_UP", "k"): st.move(-1)
            elif k in ("KEY_DOWN", "j"): st.move(1)
            elif k == "g": st.cursor = 0
            elif k == "G" and n: st.cursor = n - 1
            elif k == "KEY_PPAGE": dscroll -= list_h
            elif k == "KEY_NPAGE": dscroll += list_h
            elif k == "K": dscroll -= 1
            elif k == "J": dscroll += 1
            elif k == "/":
                searching = True
                st.query = ""
                st.cursor = 0
                off = 0
            elif k in ("KEY_ENTER", "\n"):
                r = _resume(stdscr, st, H - 1 - nh, cmd=resume_cmd)   # 提示画在状态行，不压帮助行
                if r is not None:
                    msg = r
            elif k == "y" and st.current():
                msg = _copy(st.current().first_user)          # 复制首条提问
            elif k == "Y" and st.current():
                msg = _copy(st.current().last_reply)          # 复制最后回复
            elif k == "s" and st.current():
                cur0 = st.current()
                if not cur0.sid:
                    msg = T("no_sid")
                elif cur0.sid in JOBS:
                    msg = T("sum_run")
                else:
                    msg = (T("sum_started").format(t=cur0.title[:24]) if start_summary(cur0)
                           else T("sum_fail").format(t=cur0.title[:24]))
            elif k == "o" and st.current():
                pager_open = True        # 全屏阅读当前会话详情
                pgoff = 0
            elif k in ("r", "R") and st.current():
                cur0 = st.current()
                nm = _prompt(stdscr, H - 1 - nh, T("rename_p").format(t=cur0.title[:24]))
                if nm:
                    if do_rename(cur0, nm):
                        st = _rebuild(st, scan(), st.archive_view)   # mtime 变 → 缓存自然失效重解析
                        msg = T("rename_ok").format(t=nm[:24])
                    else:
                        msg = T("op_fail").format(e="write")
            elif k == "a" and st.current() and not st.archive_view:
                try:
                    do_archive(st.current(), home)
                    st = _rebuild(st, scan(), False)
                except OSError as e:
                    msg = T("op_fail").format(e=e)
            elif k == "u" and st.current() and st.archive_view:
                try:
                    do_restore(st.current(), projects_dir)
                    st = _rebuild(st, scan(), True)
                except OSError as e:
                    msg = T("op_fail").format(e=e)
            elif k == "d" and st.current():
                try:
                    do_trash(st.current(), home)
                    st = _rebuild(st, scan(), st.archive_view)
                except OSError as e:
                    msg = T("op_fail").format(e=e)
            elif k in ("\x1b", "ESC"):                # Esc 逐级退出：清搜索/过滤 → 退出归档区
                st.query, st.project = "", None
                st.archive_view = False
                st.cursor = 0
                off = 0
            elif k == "A":
                st = AppState(st.sessions, archive_view=not st.archive_view)
                st.query, st.project = "", None
            elif k in ("KEY_F(5)", "\x0c"):   # F5 / Ctrl+L 重扫（Cmd+R 被终端截留，进不了 stdin）
                st = AppState(scan(refresh=True), archive_view=st.archive_view)
            elif k == "\t":                            # Tab: 打开项目选择弹层
                _open_picker()
    try:
        if curses is None:   # Windows 未装 windows-curses
            print("缺少 curses 组件 / curses missing:  pip install windows-curses")
            return 1
        curses.wrapper(curses_main)
        print("\x1b[2J\x1b[H", end="")   # 清残帧：q 退出后 shell/官方 picker 不与 ccs 遗留画面叠加
    except curses.error as e:
        print(f"终端初始化失败: {e}（ccs 需在真实终端运行）", file=sys.stderr)
        return 1
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
