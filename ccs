import glob as _glob, shutil as _shutil, subprocess as _subprocess, time as _time

def paths():
    projects = os.environ.get("CCS_PROJECTS_DIR",
                              os.path.expanduser("~/.claude/projects"))
    home = os.environ.get("CCS_HOME", os.path.expanduser("~/.ccs"))
    return projects, home

def config_path(home: str = "") -> str:
    return os.path.join(home or paths()[1], "config.json")

def load_config(home: str = "") -> dict:
    try:
        with open(config_path(home), encoding="utf-8") as f:
            v = json.load(f)
            return v if isinstance(v, dict) else {}
    except Exception:
        return {}

def save_config(cfg: dict, home: str = ""):
    h = home or paths()[1]
    os.makedirs(h, exist_ok=True)
    tmp = os.path.join(h, "config.json.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cfg, f, ensure_ascii=False, indent=1)
    os.replace(tmp, config_path(h))

