def _detail_lines(m, width, sums=None):
    """详情行 = 段列表 [(文本, attr), ...]，按段着色依次绘制。"""
    tilde = os.path.expanduser("~")
    try:
        lab = curses.color_pair(1) | curses.A_BOLD      # 字段名: 青色加粗
        val = curses.A_BOLD
        dim = curses.A_DIM
    except curses.error:
        lab = val = dim = curses.A_BOLD
    bar = [[("-" * max(4, width), dim)]]      # 分割线是"一行"，行内一个段
    lines = [
        [(_pad(T("f_title"), 5), lab), (m.title, val)],
        [(_pad(T("f_project"), 5), lab), (m.cwd.replace(tilde, "~"), 0)],
        [(_pad(T("f_branch"), 5), lab), (m.branch or "-", 0), (f"   {m.size // 1024} KB", dim)],
        [(_pad(T("f_id"), 5), lab), (m.sid, dim)],
    ]
    if sums is not None:
        s = sums.get(m.sid)
        if s and s.get("text"):
            lines += bar + [[(T("ai_summary"), lab)]] \
                + [[(t, 0)] for t in _md_lines(s["text"], width)]
        elif m.sid in JOBS:
            lines += bar + [[(T("ai_summary"), lab)]] + [[(T("sum_run"), dim)]]
    lines += bar + [[(T("first_q"), lab)]] \
        + [[(t, 0)] for t in _md_lines(m.first_user or T("none"), width)] \
        + bar + [[(T("last_a"), lab)]] \
        + [[(t, 0)] for t in _md_lines(m.last_reply or T("none"), width)]
    return lines

def _copy_backend():
    """剪贴板后端探测：pbcopy(macOS) → clip(Windows)。返回 (argv, encoding) 或 (None, None)。"""
    if _shutil.which("pbcopy"):
        return ["pbcopy"], "utf-8"
    if _shutil.which("clip"):        # ponytail: clip.exe 走 UTF-16 带 BOM，未在 Windows 实测
        return ["clip"], "utf-16"
    return None, None

def _copy(text: str) -> str:
    if not text:
        return T("no_copy")
    argv, enc = _copy_backend()
    if not argv:
        return T("no_copy_tool")
    _subprocess.run(argv, input=text.encode(enc), check=False)
    return T("copied").format(n=len(text))

def _clamp_off(cursor: int, off: int, n: int, cap: int) -> int:
    """滚动窗口跟随光标。cap = 实际可绘内容行数。"""
    off = max(0, min(off, max(0, n - cap)))
    if cursor < off:
        off = cursor
    if cursor >= off + cap:
        off = cursor - cap + 1
    return off

def _resume(stdscr, st, row, cmd=DEFAULT_RESUME_CMD):
    m = st.current()
    if not m or not m.sid:
        return T("no_sid")
    cwd_ok = bool(m.cwd) and os.path.isdir(m.cwd)
    eff = m.cwd
    if not cwd_ok:
        ans = _prompt(stdscr, row, T("gone_input").format(p=m.cwd or "-"))
        if not ans:
            return None
        eff = os.path.expanduser(ans)
        if not os.path.isdir(eff):
            _safe_add(stdscr, row, 0, T("gone_conf").format(p=eff))
            stdscr.refresh()
            try:
                if stdscr.getkey() not in ("\n", "KEY_ENTER"):
                    return None
            except curses.error:
                return None
            try:
                os.makedirs(eff, exist_ok=True)
            except OSError as e:
                return T("mk_fail").format(e=e)
    dargv = build_resume_argv(m, cmd=cmd)
    curses.endwin()
    if eff != os.getcwd():
        os.chdir(eff)                                # 落回会话原启动目录再恢复
    try:
        os.execvp(dargv[0], dargv)                   # 当前终端接管，正常不返回
    except OSError as e:
        return T("op_fail").format(e=e)

def _prompt(stdscr, y, label) -> str:
    curses.echo()
    _safe_add(stdscr, y, 0, label + " " * max(0, curses.COLS - _dw(label) - 1))
    stdscr.refresh()
    stdscr.timeout(-1)   # 关超时：getstr 必须阻塞到整行输入，否则半截超时返回空串
    try:
        buf = stdscr.getstr(y, _dw(label), 200)
    finally:
        stdscr.timeout(500)
    curses.noecho()
    return buf.decode("utf-8", "replace").strip()

LANG_NAMES = [("zh", "中文"), ("en", "English"), ("ja", "日本語"), ("ko", "한국어"),
              ("es", "Español"), ("fr", "Français"), ("de", "Deutsch"), ("ru", "Русский"),
              ("pt", "Português"), ("it", "Italiano")]
THEME_NAMES = ["default", "ocean", "dracula", "mono"]

_COLOR_NAMES = {"black": 0, "red": 1, "green": 2, "yellow": 3,
                "blue": 4, "magenta": 5, "cyan": 6, "white": 7}

def _user_themes(cfg: dict) -> dict:
    """config.json "custom": {名字: [强调色, 消息色]} → {名字: (accent, msg)}。
    颜色取 8 色名或 0-255 整数；非法条目静默忽略。"""
    out = {}
    for name, v in (cfg.get("custom") or {}).items():
        pair = []
        if isinstance(v, list) and len(v) == 2:
            for c in v:
                if isinstance(c, str) and c in _COLOR_NAMES:
                    pair.append(_COLOR_NAMES[c])
                elif isinstance(c, int) and not isinstance(c, bool) and 0 <= c <= 255:
                    pair.append(c)
        if len(pair) == 2:
            out[name] = (pair[0], pair[1])
    return out

def run_config_plain(cfg: dict, first_run: bool) -> None:
    """无 curses 环境（Windows 未装补齐包）的顺序问答降级路径。"""
    print("== ccs 首次配置 / first-run setup ==" if first_run else "== ccs 配置 / config ==")
    for i, (code, name) in enumerate(LANG_NAMES, 1):
        mark = "*" if cfg.get("lang", "zh") == code else " "
        print(f"  {i:>2}){mark} {name} ({code})")
    raw = input(f"Language [1-{len(LANG_NAMES)}, Enter=keep]: ").strip()
    if raw.isdigit() and 1 <= int(raw) <= len(LANG_NAMES):
        cfg["lang"] = LANG_NAMES[int(raw) - 1][0]
    themes = THEME_NAMES + [n for n in _user_themes(cfg) if n not in THEME_NAMES]
    for i, name in enumerate(themes, 1):
        mark = "*" if cfg.get("theme", "default") == name else " "
        print(f"  {i}){mark} {name}")
    raw = input(f"Theme [1-{len(themes)}, Enter=keep]: ").strip()
    if raw.isdigit() and 1 <= int(raw) <= len(themes):
        cfg["theme"] = themes[int(raw) - 1]
    print(f"resume_cmd [{cfg.get('resume_cmd', DEFAULT_RESUME_CMD).replace(' --resume {sid}', '')}]"
          " (auto appends --resume {sid}): ", end="")
    raw = input().strip()
    if raw:
        cfg["resume_cmd"] = raw
    save_config(cfg)
    print(f"saved -> {config_path()}")

