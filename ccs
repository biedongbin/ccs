try:
    locale.setlocale(locale.LC_ALL, "")
except locale.Error:
    pass
from dataclasses import dataclass

INTERNAL_PREFIXES = ("Below is a conversation log", "Caveat: The messages below",
                      "<local-command", "<command-name>", "<command-message>", "<command-args>",
                      "This session is being continued")

@dataclass
class SessionMeta:
    sid: str; title: str; cwd: str; branch: str = ""
    mtime: float = 0.0; size: int = 0; path: str = ""
    first_user: str = ""; last_reply: str = ""; summary: str = ""
    archived: bool = False
    entrypoint: str = ""    # sdk-cli = compact/SDK 衍生会话（默认隐藏）
    custom_title: str = ""  # /rename 写入，官方 picker 最高优先
    ai_title: str = ""      # 后台小模型生成，次优先

@dataclass
class Sidecar:
    leaf: str; summary: str

def text_of(content) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(b.get("text", "") for b in content
                         if isinstance(b, dict) and b.get("type") == "text")
    return ""

def _is_internal(text: str) -> bool:
    return any(text.startswith(p) for p in INTERNAL_PREFIXES)

def parse_jsonl(path: str, budget: int = 65536):
    """读头尾各 budget 字节。返回 SessionMeta / Sidecar / None(读不了)。永不抛错。"""
    try:
        st = os.stat(path)
        with open(path, "rb") as f:
            head = f.read(budget)
            f.seek(max(0, st.st_size - budget))
            tail = f.read()
    except OSError:
        return None
    meta = SessionMeta(sid="", title="", cwd="", mtime=st.st_mtime, size=st.st_size, path=path)
    first_user = ""; last_reply = ""; saw_content = False
    def feed(line: bytes):
        nonlocal first_user, last_reply, saw_content
        try:
            o = json.loads(line)
        except Exception:
            return
        if not isinstance(o, dict):
            return
        t = o.get("type")
        if t == "summary":
            if not meta.summary and o.get("summary"):
                meta.summary = str(o["summary"])
            if "leafUuid" in o:
                return  # 纯 sidecar 由下方终检判定
        if not meta.sid and o.get("sessionId"):
            meta.sid = o["sessionId"]
        if not meta.cwd and o.get("cwd"):
            meta.cwd = o["cwd"]
        if not meta.branch and o.get("gitBranch"):
            meta.branch = o["gitBranch"]
        if not meta.entrypoint and o.get("entrypoint"):
            meta.entrypoint = str(o["entrypoint"])
        if t == "ai-title" and o.get("aiTitle"):
            meta.ai_title = str(o["aiTitle"])          # append-only：后写覆盖先写
        if t == "custom-title" and o.get("customTitle"):
            meta.custom_title = str(o["customTitle"])
        msg = o.get("message")
        content = msg.get("content") if isinstance(msg, dict) else None
        if t == "user" and not o.get("isSidechain"):
            txt = text_of(content).strip()
            if txt and not _is_internal(txt):
                saw_content = True
                if not first_user:
                    first_user = txt
        elif t == "assistant":
            txt = text_of(content).strip()
            if txt:
                saw_content = True
                last_reply = txt
    nlines = 0
    for line in head.splitlines():
        feed(line); nlines += 1
    for line in tail.splitlines():
        feed(line)
    # 纯 summary sidecar: 只有一行且是 summary（feed 里没消费，直接重查）
    if nlines <= 1 and b'"type":"summary"' in head.replace(b" ", b""):
        try:
            o = json.loads(head.splitlines()[0])
            if isinstance(o, dict) and o.get("type") == "summary" and not saw_content:
                return Sidecar(leaf=o.get("leafUuid", ""), summary=str(o.get("summary", "")))
        except Exception:
            pass
    if not first_user:   # 兜底：真实首问在头尾采样窗外（hook 样板挤占头部）→ 流式全扫
        try:
            with open(path, "rb") as f:
                for line in f:
                    try:
                        o = json.loads(line)
                    except Exception:
                        continue
                    if not isinstance(o, dict) or o.get("type") != "user" or o.get("isSidechain"):
                        continue
                    msg = o.get("message")
                    content = msg.get("content") if isinstance(msg, dict) else None
                    txt = text_of(content).strip()
                    if txt and not _is_internal(txt):
                        first_user = txt
                        saw_content = True
                        break
        except OSError:
            pass
    meta.title = re.sub(r"\s+", " ", (meta.custom_title[:80] or meta.ai_title[:80]
                        or meta.summary[:80] or first_user[:80]
                        or os.path.basename(path).removesuffix(".jsonl"))).strip() or "(空会话)"
    meta.first_user, meta.last_reply = first_user[:500], last_reply[:4000]   # 末答放宽：详情栏主浏览区，500 严重截断
    enc = os.path.basename(os.path.dirname(path))
    # 启动目录=编码目录还原，从哪打开归哪；realpath 归一符号链接（/tmp→/private/tmp 类）
    _cwd0 = launch_dir(enc, meta.cwd) or meta.cwd
    meta.cwd = os.path.realpath(_cwd0) if _cwd0 else ""
    return meta

def rel_time(ts: float, now: float) -> str:
    d = max(0, now - ts)
    if d < 60: return T("rel_now")
    if d < 3600: return T("rel_m").format(n=int(d // 60))
    if d < 86400: return T("rel_h").format(n=int(d // 3600))
    return T("rel_d").format(n=int(d // 86400))

