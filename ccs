import unicodedata as _ud

def _dw(s: str) -> int:
    """显示宽度：Unicode 官方宽度表。全角(W/F)与歧义宽度(A)按 2 列——
    CJK 终端把 A 渲染为宽，宁左勿右（多算只会留缝，少算会破框）；
    组合符号(如 e + U+0301)占 0 列。"""
    w = 0
    for ch in s:
        if _ud.combining(ch):
            continue
        w += 2 if _ud.east_asian_width(ch) in ("W", "F", "A") else 1
    return w

def _cut(s: str, w: int) -> str:
    """按显示宽度截断。"""
    out, cw = "", 0
    for ch in s:
        c = 2 if ord(ch) > 0x2E80 else 1
        if cw + c > w:
            break
        out += ch
        cw += c
    return out

def _pad(s: str, w: int) -> str:
    """按显示宽度 pad 到 w 列。"""
    return _cut(s, w) + " " * max(0, w - _dw(s))

def _box(stdscr, top, left, w, h, attr=0):
    for y, x, ch in ((top, left, curses.ACS_ULCORNER), (top, left + w - 1, curses.ACS_URCORNER),
                     (top + h - 1, left, curses.ACS_LLCORNER), (top + h - 1, left + w - 1, curses.ACS_LRCORNER)):
        try:
            stdscr.addch(y, x, ch, attr)
        except curses.error:
            pass
    for y, x, ch, n in ((top, left + 1, curses.ACS_HLINE, w - 2), (top + h - 1, left + 1, curses.ACS_HLINE, w - 2)):
        try:
            stdscr.hline(y, x, ch, n, attr)
        except curses.error:
            pass
    for y, x, ch, n in ((top + 1, left, curses.ACS_VLINE, h - 2), (top + 1, left + w - 1, curses.ACS_VLINE, h - 2)):
        try:
            stdscr.vline(y, x, ch, n, attr)
        except curses.error:
            pass

def _hard_wrap(t: str, w: int):
    """按 '|' 快捷键段贪心折行：同一键的说明永不拆成两行（宽 CJK 按 2 列计）。"""
    out, cur, cw = [], "", 0
    for raw in t.split("|"):
        seg = raw.strip()
        if not seg:
            continue
        lead = 3 if cur else 1                    # 行首前导 1 列；段间 " | " 计 3 列
        sw = _dw(seg)
        if cur and cw + lead + sw > w:
            out.append(cur)
            cur, cw, lead = "", 0, 1
        if lead + sw > w:                         # 单段超行宽（W≥60 不会触发）才钳断
            seg = _cut(seg, max(1, w - lead))
            sw = _dw(seg)
        cur += (" " if not cur else " | ") + seg
        cw += lead + sw
    if cur:
        out.append(cur)
    return out or [""]

def _fold_wide(line: str, w: int):
    """字符级 CJK 折行：超宽行按显示列断开（宽字符 2 列）。"""
    if _dw(line) <= w:
        return [line]
    out, cur, cw = [], "", 0
    for ch in line:
        c = 2 if ord(ch) > 0x2E80 else 1
        if cw + c > w:
            out.append(cur); cur, cw = "", 0
        cur += ch; cw += c
    if cur:
        out.append(cur)
    return out

def _md_table(rows, w: int):
    """'|' 行族 → 对齐文本行。跳过 |---| 对齐行；列宽=max 显示宽，双空格分隔。"""
    body = [r for r in rows
            if not (re.fullmatch(r"[ \t:|-]+", r) and "-" in r)]
    grid = [[re.sub(r"\*\*([^*]+)\*\*", r"\1", c.strip())
             for c in r.strip().strip("|").split("|")] for r in body]
    if not grid:
        return []
    ncol = max(len(r) for r in grid)
    widths = [max(_dw(r[i]) if i < len(r) else 0 for r in grid) for i in range(ncol)]
    out = []
    for r in grid:
        s = "  ".join(_pad(r[i] if i < len(r) else "", widths[i]) for i in range(ncol))
        out.append(_cut(s.rstrip(), w))
    return out

def _md_lines(text: str, w: int):
    """markdown 轻渲染 → 显示行列表（每行 ≤ w 列）。
    ponytail: 无内联着色/嵌套结构渲染，只做表格对齐+标题+列表+围栏+粗体剥离；升级走 attr 分段。"""
    out, fence = [], False
    raw_lines = text.split("\n")
    i = 0
    while i < len(raw_lines):
        ln = raw_lines[i]
        if ln.strip().startswith("```"):          # 围栏：只切换状态，不输出
            fence = not fence
            i += 1
            continue
        if fence:
            out.append("  " + ln)                  # fence 内原样（2 空格缩进），不做转换
            i += 1
            continue
        if ln.lstrip().startswith("|") and i + 1 < len(raw_lines) and raw_lines[i + 1].lstrip().startswith("|"):
            j = i
            while j < len(raw_lines) and raw_lines[j].lstrip().startswith("|"):
                j += 1
            out += _md_table(raw_lines[i:j], w)
            i = j
            continue
        s = ln.rstrip()
        m = re.match(r"^(#{1,})\s+(.*)$", s)
        if m:
            s = ("■ " if len(m.group(1)) == 1 else "▪ " if len(m.group(1)) == 2 else "· ") + m.group(2)
        else:
            m = re.match(r"^(\s*)[-*] (.*)$", s)
            if m:
                s = m.group(1) + "• " + m.group(2)
        s = re.sub(r"\*\*([^*]+)\*\*", r"\1", s)
        out.append(s)
        i += 1
    folded = []
    for ln in out:
        folded += _fold_wide(ln, w)
    return folded or [""]

